// Numbers: comparing and combining them, and functions of floats that are
// the same on every platform.

// Mathematical constants.
pub const PI: f32 = 3.14159265;
pub const TAU: f32 = 6.28318531;
pub const E: f32 = 2.71828183;
pub const PI_F64: f64 = 3.141592653589793;
pub const TAU_F64: f64 = 6.283185307179586;
pub const E_F64: f64 = 2.718281828459045;

impl i8 {
    // The value without its sign.
    pub func abs(self) -> Self { if self < 0 { -self } else { self } }

    // The smaller of the values.
    pub func min(self, other: Self) -> Self { if other < self { other } else { self } }

    // The larger of the values.
    pub func max(self, other: Self) -> Self { if other > self { other } else { self } }

    // The value, kept between `low` and `high`.
    pub func clamp(self, low: Self, high: Self) -> Self { if self < low { low } else if self > high { high } else { self } }
}

impl i16 {
    // The value without its sign.
    pub func abs(self) -> Self { if self < 0 { -self } else { self } }

    // The smaller of the values.
    pub func min(self, other: Self) -> Self { if other < self { other } else { self } }

    // The larger of the values.
    pub func max(self, other: Self) -> Self { if other > self { other } else { self } }

    // The value, kept between `low` and `high`.
    pub func clamp(self, low: Self, high: Self) -> Self { if self < low { low } else if self > high { high } else { self } }
}

