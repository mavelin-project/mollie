impl f32 {
    // The smaller of the values.
    pub func min(self, other: Self) -> Self { if other < self { other } else { self } }

    // The larger of the values.
    pub func max(self, other: Self) -> Self { if other > self { other } else { self } }

    // The value, kept between `low` and `high`.
    pub func clamp(self, low: Self, high: Self) -> Self { if self < low { low } else if self > high { high } else { self } }

    // The nearest integer, halfway cases away from zero.
    pub func round(self) -> Self {
        let whole = self.trunc();

        if (self - whole).abs() >= 0.5 {
            if self < 0.0 { whole - 1.0 } else { whole + 1.0 }
        } else {
            whole
        }
    }

    // The value `t` of the way from this one to `to`.
    pub func lerp(self, to: Self, t: Self) -> Self { self + (to - self) * t }

    // -1, 0 or 1, by the sign of the value.
    pub func signum(self) -> Self { if self > 0.0 { 1.0 } else if self < 0.0 { -1.0 } else { 0.0 } }

    pub func to_radians(self) -> Self { self * PI / 180.0 }

    pub func to_degrees(self) -> Self { self * 180.0 / PI }
}

impl f64 {
    // The smaller of the values.
    pub func min(self, other: Self) -> Self { if other < self { other } else { self } }

    // The larger of the values.
    pub func max(self, other: Self) -> Self { if other > self { other } else { self } }

    // The value, kept between `low` and `high`.
    pub func clamp(self, low: Self, high: Self) -> Self { if self < low { low } else if self > high { high } else { self } }

    // The nearest integer, halfway cases away from zero.
    pub func round(self) -> Self {
        let whole = self.trunc();

        if (self - whole).abs() >= 0.5 {
            if self < 0.0 { whole - 1.0 } else { whole + 1.0 }
        } else {
            whole
        }
    }

    // The value `t` of the way from this one to `to`.
    pub func lerp(self, to: Self, t: Self) -> Self { self + (to - self) * t }

    // -1, 0 or 1, by the sign of the value.
    pub func signum(self) -> Self { if self > 0.0 { 1.0 } else if self < 0.0 { -1.0 } else { 0.0 } }

    pub func to_radians(self) -> Self { self * PI_F64 / 180.0 }

    pub func to_degrees(self) -> Self { self * 180.0 / PI_F64 }
}
